{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FileCommand",
  "type": "object",
  "required": ["action", "path"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["read", "write", "append", "delete"]
    },
    "path": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  }
}
