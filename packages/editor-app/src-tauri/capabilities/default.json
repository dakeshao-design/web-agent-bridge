{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.webagent.editor",
  "windows": ["main", "agent-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:window:default",
    "core:window:allow-create",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "fs:allow-copy-file",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    }
  ],
  "remote": {
    "urls": [
      "http://localhost/**",
      "http://127.0.0.1/**"
    ]
  }
}
