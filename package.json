{
  "name": "my-agent-editor",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "pnpm --filter WABEditor dev",
    "build": "pnpm -r build",
    "clean": "node clean.mjs",
    "tauri": "pnpm --filter WABEditor tauri",
    "agent-host": "pnpm --filter agent-host start",
    "ext:compile": "pnpm --filter webagent-bridge compile",
    "ext:watch": "pnpm --filter webagent-bridge watch",
    "ext:package": "pnpm --filter WABEditor exec tauri build && pnpm --filter @my-agent-editor/shared build && pnpm --filter webagent-bridge package"
  },
  "engines": {
    "node": ">=18"
  }
}
